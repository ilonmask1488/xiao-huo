        { "answer": "bao3", "options": ["bao3", "pao3"] },
        { "answer": "pu4", "options": ["bu4", "pu4"] }
      ] },
      { "type": "whichSyllable", "contrast": { "label": "d/t", "skill": "initial" }, "items": [
