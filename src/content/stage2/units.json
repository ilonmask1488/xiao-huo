  "grammarNotes": [
   {
    "title": "也 — «тоже»",
    "ru": "也 стоит перед глаголом, никогда в начале фразы: 我也是工程师 — «я тоже инженер». Не «也我是».",
    "examples": [
     "s-2-1-05",
     "s-2-1-06"
    ]
   },
   {
    "title": "您 и 贵姓 — вежливо",
    "ru": "您 — «вы» старшим и незнакомым. Фамилию вежливо спрашивают 您贵姓？, отвечают 我姓… — 贵 в ответе не повторяют.",
    "examples": [
     "s-2-1-01",
     "s-2-1-02"
    ]
   },
   {
    "title": "Семья без 的",
    "ru": "С близкими людьми 的 обычно опускают: 我哥哥, 她丈夫. С вещами — 我的书.",
    "examples": [
     "s-2-1-04",
     "s-2-1-09",
     "s-2-1-10"
    ]
   }
  ],
  "boss": "s2-u1-boss"
